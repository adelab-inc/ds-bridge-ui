{
  "name": "@storybook/standalone",
  "version": "1.0.0",
  "private": true,
  "description": "Storybook Standalone - UI Component Library",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.22.1",
    "pnpm": "^10.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:storybook": "turbo dev --filter=storybook",
    "start:storybook": "turbo start --filter=storybook",
    "build:storybook": "turbo build --filter=storybook && pnpm schema:extract",
    "build:ui": "turbo build --filter=@aplus/ui",
    "build:validator": "pnpm --filter storybook-validator build",
    "schema:extract": "tsx scripts/extract-component-schema.ts",
    "ag-grid:extract": "tsx scripts/extract-ag-grid-tokens.ts",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.23",
    "postcss-loader": "^8.2.0",
    "prettier": "^3.6.2",
    "react-docgen-typescript": "^2.4.0",
    "serve": "^14.2.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "turbo": "^2.9.14",
    "vite": "^7.3.7",
    "zod": "^4.6.6",
    "webpack": "^5.112.2"
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "@types/react": "18.3.24",
      "@types/react-dom": "18.3.7",
      "typescript": "5.9.2",
      "eslint": "9.36.0",
      "vitest": "^4.1.11",
      "ag-grid-community": "34.2.0",
      "ag-grid-react": "34.2.0",
      "ag-charts-community": "12.2.0",
      "ag-charts-react": "12.2.0",
      "ag-charts-enterprise": "12.2.0",
      "@types/node": "24.3.0",
      "@babel/core@>=7.0.0 <7.29.6": "^7.29.6",
      "@hono/node-server@>=1.0.0 <1.19.15": "^1.19.15",

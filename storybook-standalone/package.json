      "browserslist@>=4.0.0 <4.28.7": "^4.28.7",
      "compression@>=1.0.0 <1.8.2": "^1.8.2",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
      "flatted@>=3.0.0 <3.4.2": "^3.4.2",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "hono@>=4.0.0 <4.13.11": "^4.13.11",

{
  "name": "ds-bridge-ui",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "^24.22.1",
    "pnpm": "^10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ds-hub/web dev",
    "build": "pnpm --filter @ds-hub/web build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm --filter @ds-hub/web format",
    "format:fix": "pnpm --filter @ds-hub/web format:fix",
    "typecheck": "pnpm -r typecheck",
    "gen:firebase-types": "pnpm --filter @ds-hub/shared-types gen:firebase-types",
    "gen:api-types": "pnpm --filter @ds-hub/shared-types gen:api-types",
    "gen:types": "pnpm --filter @ds-hub/shared-types gen:types"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "eslint-plugin-react-hooks": "7.0.1",
      "@babel/core@>=7.0.0 <7.29.6": "^7.29.6",
      "@hono/node-server@>=1.0.0 <1.19.15": "^1.19.15",
      "@modelcontextprotocol/sdk@>=1.0.0 <1.32.0": "^1.32.0",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "^2.11.0",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "brace-expansion@>=1.0.0 <1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "browserslist@>=4.0.0 <4.28.7": "^4.28.7",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
      "hono@>=4.0.0 <4.13.11": "^4.13.11",
      "ip-address@>=10.0.0 <10.7.4": "^10.7.4",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "postcss@>=8.0.0 <8.5.23": "^8.5.23",
      "postcss-selector-parser@>=7.0.0 <7.1.6": "^7.1.6",
      "proxy-addr@>=2.0.0 <2.0.8": "^2.0.8",
      "qs@>=6.0.0 <6.16.0": "^6.16.0",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "undici@>=7.0.0 <7.30.1": "^7.30.1",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "zod@>=4.0.0 <4.6.6": "^4.6.6"
    }
  }
}
